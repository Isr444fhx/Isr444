// 15. Pedir al usuario un número y mostrar si es mayor 0 y menor o igual a 100. 

Algoritmo EJERCICIO_15
	//definir la variable que usaremos
	// n1(leer)
	Definir n1 Como Entero
	N1 <- 0
    Escribir "Ingrese un número:"
    Leer n1
	//Proceso 
	//realizar las operaciones que el enunciado pide, asigando el valor a n1
	//calcular
	
    Si N1 > 0 Y N1 <= 100 Entonces
        Escribir "El número está en el rango (mayor que 0 y menor o igual a 100)."
    Sino
        Escribir "El número no está en el rango."
    FinSi
	//salida
FinAlgoritmo // fin del algoritmo
