// Solicitar al usuario un número y mostrar si es un número de un solo dígito.

Algoritmo EJERCICIO_16
	//definir la variable que usaremos
	// n1(leer)
	Definir n1 Como Entero
    N1 <- 0
    Escribir "Ingrese un número:"
    Leer n1
	//Proceso 
	//realizar las operaciones que el enunciado pide, asigando el valor a n1
	//calcular
	
    Si n1 >= -9 Y n1 <= 9 Entonces
        Escribir "El número es de un solo dígito."
    Sino
        Escribir "El número NO es de un solo dígito."
    FinSi
	//salida
FinAlgoritmo // fin del algoritmo
